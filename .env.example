# MulteAgent settings — copy to .env and set ONLY what differs from the default shown here.
# Secrets live in .env only. Server logins (SSH) are never stored here: they are typed in the app
# (Settings → Servers) and kept in memory for the session.

# ── Secrets (required) ─────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
IMAGE_SERVICE_TOKEN=change-me
POSTGRES_PASSWORD=change-me
BRAIN_APP_PASSWORD=change-me
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
SEARXNG_SECRET=change-me

# ── Databases ──────────────────────────────────────────────────────
# App data (own login, never the Postgres superuser). Leave out = SQLite in data/multeagent.db
DATABASE_URL=postgresql+psycopg://multeagent_app:change-me@127.0.0.1:5432/multeagent
BRAIN_DATABASE_URL=postgresql+psycopg://multeagent:change-me@127.0.0.1:5432/multeagent

# ── Language model (Ollama) ────────────────────────────────────────
# LLM_BASE_URL=http://127.0.0.1:11434        # 127.0.0.1, not localhost (+2 s per call on Windows)
# LLM_MODEL=qwen3.5:9b
# MODEL_FAST=qwen3.5:9b
# MODEL_STRONG=qwen3.5:9b
# MODEL_VISION=qwen3.5:9b
# MODEL_EMBED=qwen3-embedding:0.6b
# LLM_TEMPERATURE=0.4
# LLM_NUM_CTX=8192
# LLM_TIMEOUT_SECONDS=300
LLM_THINK=false                              # false = answer directly (~1 s instead of ~60 s)

# ── Images (SDXL) ──────────────────────────────────────────────────
# MODEL_IMAGE_PATH=D:/multeagent/models/checkpoints/RealVisXL_V5.0_fp16.safetensors
# IMAGE_FAST_CHECKPOINT=RealVisXL_V5.0_Lightning_fp16.safetensors
# IMAGE_PROFILE=fast                         # fast | balanced | quality
# IMAGE_WIDTH=768
# IMAGE_HEIGHT=768
# IMAGE_STEPS= / IMAGE_GUIDANCE= / IMAGE_STRENGTH=   # override the profile
# IMAGE_PROMPT_REWRITE=true                  # the model turns short requests into full prompts
# IMAGE_IDLE_UNLOAD_MINUTES=10               # 0 = keep the model loaded
# IMAGE_SERVICE_PORT=8790
# IMAGE_UNLOAD_OLLAMA=true                   # free the GPU for images

# ── Knowledge base ─────────────────────────────────────────────────
# BRAIN_ENABLED=true
# BRAIN_NO_EVIDENCE=general                  # general = say so, then answer · refuse = say so only
# BRAIN_SCHEDULER=true
# BRAIN_SCHEDULER_MINUTES=30
# BRAIN_REFRESH_WINDOW=                      # e.g. 01-06 = refresh at night only
# BRAIN_FRESH_HOURS=24                       # older sources are re-checked when an answer uses them
# VERIFY_ANSWERS=true                        # check each answer against its sources afterwards (~8 s)

# ── Tools ──────────────────────────────────────────────────────────
# ASSISTANT_TOOLS=true                       # the model picks its tools; false = the older router
WEB_SEARCH_URL=http://127.0.0.1:8888         # SearXNG (docker compose up -d searxng)
# NETWORK_SCAN_ENABLED=true                  # private ranges only
# NETWORK_SCAN_MAX_HOSTS=1024
# SECURITY_SCAN_ENABLED=true                 # security_check, admins only

# ── Server, users, queue ───────────────────────────────────────────
# API_HOST=0.0.0.0                           # 0.0.0.0 = reachable from the LAN
# API_PORT=8787
# JWT_EXPIRE_MINUTES=720
# DEFAULT_ADMIN_USER=admin                   # first start only — change the password in the app
# DEFAULT_ADMIN_PASSWORD=admin123
# LLM_SLOTS=1
# MAX_ACTIVE_JOBS_PER_USER=1
# QUEUE_DEPTH_LIMIT=40
