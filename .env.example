# Local LLM (Ollama-compatible)
# 127.0.0.1, not localhost: on Windows localhost adds ~2 s to every request (IPv6 tried first)
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=300
# Ollama per-request context window (raise if you see "request exceeds model context length")
LLM_NUM_CTX=8192
# Ollama "think" mode: false = answer directly (qwen3.5:9b ~1s vs ~60s), true = reason first,
# blank = model default. Reasoning output is never shown, so false is the fast choice.
LLM_THINK=false

# Model routing roles — one model on the 8GB GPU avoids load/unload swaps (see benchmark)
MODEL_FAST=qwen3.5:9b
MODEL_STRONG=qwen3.5:9b
MODEL_CLOUD=
MODEL_VISION=qwen3.5:9b
# MODEL_VISION=gemma4:12b   # compare on your screenshots; does not fit fully in 8GB VRAM
# Embedding model for the knowledge brain (multilingual). Not wired into code yet.
MODEL_EMBED=qwen3-embedding:0.6b
# Display label for local Diffusers SDXL (not an Ollama model name)
MODEL_IMAGE=sdxl-local

# Local SDXL checkpoint (Diffusers). Leave unset to auto-use
# models/checkpoints/sd_xl_base_1.0.safetensors when that file exists.
# Known files get their model page's settings (src/image_models.py): RealVisXL V5.0, Juggernaut XL v9.
# MODEL_IMAGE_PATH=D:/multeagent/models/checkpoints/sd_xl_base_1.0.safetensors
# MODEL_IMAGE_PATH=D:/multeagent/models/checkpoints/RealVisXL_V5.0_fp16.safetensors
# MODEL_IMAGE_PATH=D:/multeagent/models/checkpoints/Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors
# Size when no profile is chosen. --ar 16:9 in a request keeps the pixel count, changes the shape.
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
# fast (768, 16 steps, ~40 s) | balanced (896, 20) | quality (1024, 28, ~2 min) — steps/guidance/size
IMAGE_PROFILE=fast
# Optional hard overrides (win over profile when set):
IMAGE_STEPS=16
IMAGE_GUIDANCE=5.5
IMAGE_STRENGTH=0.4
IMAGE_NEGATIVE_PROMPT=lowres, blurry, distorted, watermark, text, logo, deformed, ugly
IMAGE_PROMPT_POLISH=true
# The chat model rewrites short requests into detailed SDXL prompts and picks the aspect ratio
IMAGE_PROMPT_REWRITE=true
# Checkpoint file (in models/checkpoints) for the "fast" profile; empty = MODEL_IMAGE_PATH
# IMAGE_FAST_CHECKPOINT=RealVisXL_V5.0_Lightning_fp16.safetensors
# Replacement VAE (Hugging Face id or folder); empty = the checkpoint's own VAE.
# madebyollin/sdxl-vae-fp16-fix was tested: no speed gain on the P4000, so it is off.
IMAGE_VAE=
# Load SDXL at API start (holds ~8-16 GB RAM before any image is asked for). Off = load on first image.
IMAGE_WARM_ON_START=false
# Free SDXL from RAM after this many minutes without image jobs (0 = keep loaded)
IMAGE_IDLE_UNLOAD_MINUTES=10
# SDXL runs in its own process (python -m src.image_service), started on the first image request
IMAGE_SERVICE_PORT=8790
IMAGE_SERVICE_TOKEN=change-me
IMAGE_SERVICE_AUTOSTART=true
IMAGE_UNLOAD_OLLAMA=true
# Faster VAE decode (downloads taesdxl on first use)
IMAGE_TINY_VAE=false
IMAGE_SLOTS=1

# App data (users, jobs, events): Postgres in the same database as the brain, schema `app`, with its
# OWN login — never the `multeagent` owner (a superuser skips the brain's per-account privacy rules).
# One-time setup:  python -m src.app_db setup   then   python -m src.app_db copy   (from SQLite)
DATABASE_URL=postgresql+psycopg://multeagent_app:change-me@127.0.0.1:5432/multeagent
# Without Postgres (no Docker): leave DATABASE_URL out to use data/multeagent.db (SQLite)

# Knowledge brain — Postgres + pgvector in Docker (docker compose up -d db)
POSTGRES_PASSWORD=change-me
BRAIN_DATABASE_URL=postgresql+psycopg://multeagent:change-me@127.0.0.1:5432/multeagent
# Restricted login the app uses (row-level security applies); created by: python -m src.brain.migrate
BRAIN_APP_PASSWORD=change-me
# Chat answers real questions from the knowledge brain, with [n] citations
BRAIN_ENABLED=true
# When the brain has nothing relevant: general = say so, then answer from the model's own
# knowledge (clearly marked as unverified) · refuse = only say the knowledge base has nothing
BRAIN_NO_EVIDENCE=general
# Automatic refresh of sources whose refresh_every has passed (runs inside the API)
BRAIN_SCHEDULER=true
# Local hours for refreshes, e.g. 01-06 (night only); empty = any time
BRAIN_REFRESH_WINDOW=
BRAIN_SCHEDULER_MINUTES=30
# On demand: a source an answer uses that was not checked for this many hours is re-checked right away
# in the background (only changed pages are downloaded); the answer shows "checked 3 h ago".
BRAIN_FRESH_HOURS=24
# pgAdmin web login (http://localhost:5050) — docker compose --profile tools up -d pgadmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# Private web search — SearXNG in Docker on 127.0.0.1:8888 (never on the LAN).
# Start it:  docker compose up -d searxng   · used only when you ask "search the web …".
# Generate the secret once:  python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=change-me
WEB_SEARCH_URL=http://127.0.0.1:8888

# network_scan tool ("check all the IPs on the network…"): private ranges only (10.x, 172.16-31.x,
# 192.168.x), read-only ping + fixed port list, 60 s limit. It sees the network of the computer
# the server runs on. false = switched off. Max addresses per scan: 1024 = a /22 (hard ceiling 4096).
NETWORK_SCAN_ENABLED=true
NETWORK_SCAN_MAX_HOSTS=1024

# The assistant picks tools itself (knowledge base, web search, weather, network scan, image, diagram,
# document) — src/assistant.py. false = the older example-based router (data/router/intents.yaml).
ASSISTANT_TOOLS=true

# Auth
JWT_SECRET=change-me-multeagent-dev-secret-32b+
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
SSO_ENABLED=false

# Fair scheduling
LLM_SLOTS=1
MAX_ACTIVE_JOBS_PER_USER=1
QUEUE_DEPTH_LIMIT=40
OVERFLOW_WAIT_SECONDS=45

# Tools / artifacts
HTTP_ALLOWLIST=localhost,127.0.0.1,ollama.com,raw.githubusercontent.com
ARTIFACTS_DIR=artifacts
LOG_DIR=logs

# API bind (0.0.0.0 for LAN team access)
API_HOST=0.0.0.0
API_PORT=8787
